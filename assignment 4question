#include <stdio.h>
#include <string.h>
#include <ctype.h>

int valid(char s[])
{
    int i;

    if (strlen(s) == 0 || strlen(s) > 31)
        return 0;

    for (i = 0; s[i] != '\0'; i++)
    {
        if (!isalnum((unsigned char)s[i]) &&
            s[i] != '-' && s[i] != ' ')
            return 0;
    }

    return 1;
}

void normalize(char s[], char result[])
{
    int i, j = 0;

    for (i = 0; s[i] != '\0'; i++)
    {
        if (s[i] != '-' && s[i] != ' ')
            result[j++] = s[i];
    }

    result[j] = '\0';
}

int main()
{
    char meter1[32], meter2[32];
    char n1[32], n2[32];
    char bill[32];

    printf("Enter first meter ID: ");
    fgets(meter1, sizeof(meter1), stdin);
    meter1[strcspn(meter1, "\n")] = '\0';

    printf("Enter second meter ID: ");
    fgets(meter2, sizeof(meter2), stdin);
    meter2[strcspn(meter2, "\n")] = '\0';

    if (!valid(meter1) || !valid(meter2))
    {
        printf("Invalid meter ID");
        return 0;
    }

    normalize(meter1, n1);
    normalize(meter2, n2);

    if (strcmp(n1, n2) == 0)
        printf("Meter IDs match\n");
    else
        printf("Meter IDs do not match\n");

    if (snprintf(bill, sizeof(bill),
                 "BILL-%s", meter1) >= sizeof(bill))
    {
        printf("Bill reference too long");
        return 0;
    }

    printf("Bill Reference: %s", bill);

    return 0;
}